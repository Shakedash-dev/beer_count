<?xml version="1.0" encoding="utf-8"?>
<!-- Goal mode: an amber glow rising from the bottom, and an amber rim. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:endColor="#141416"
        android:centerColor="#1E1810"
        android:startColor="#3A2A12"
        android:type="linear" />
    <stroke android:width="1.5dp" android:color="#E8A33D" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
